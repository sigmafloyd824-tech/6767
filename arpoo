function AR2_themeGui(gui)
 if not gui or not AR2_THEMED_GUIS[gui.Name] then return end

 if AR2_UILIB and type(AR2_UILIB.ReskinGui) == "function" then
 pcall(function() AR2_UILIB:ReskinGui(gui) end)
 end
 local S = AR2_skin()
 local accent, bg, panel, text = S.accent, S.bg, S.panel, S.text
 pcall(function() AR2_themeGuiMaterials(gui) end)
 for _, d in ipairs(gui:GetDescendants()) do
 pcall(function()
 if d:GetAttribute("ar2_notheme") then return end
 if d:IsA("ScrollingFrame") or d:IsA("Frame") then
 if d.BackgroundTransparency < 1 then d.BackgroundColor3 = bg end
 elseif d:IsA("TextButton") then
 d.BackgroundColor3 = panel
 d.TextColor3       = text
 d.Font             = AR2_FONT_BOLD
 elseif d:IsA("TextBox") then
 d.BackgroundColor3 = panel
 d.TextColor3       = text
 d.Font             = AR2_FONT
 elseif d:IsA("TextLabel") then
 d.TextColor3 = text
 if d.Font ~= Enum.Font.Code then d.Font = AR2_FONT end
 elseif d:IsA("UIStroke") then
 d.Color = accent
 end
 end)
 end
end
