 else
 dot.Size = UDim2.fromOffset(5, 5)
 end
 local u, v = AR2_worldToMap(pRoot.Position)
 dot.Position = UDim2.fromScale(u, v)
 dot.Visible = true
 end
 until true end
 for j = i+1, #AR2_minimapDots do AR2_minimapDots[j].Visible = false end
 AR2_minimapZDots = AR2_minimapZDots or {}
 local z = 0
 if AR2_CFG.minimap.zombies then
 local mc = AR2_CFG.minimap
 local rareBelow = tonumber(AR2_CFG.zombies.rareBelow) or 0.3
 local eventsOnly = AR2_CFG.minimap.eventsOnly
 local ok = pcall(function()
 for _, e in ipairs(AR2_api.zombies()) do
 if z >= 40 then break end
 if e.distance and e.distance <= (tonumber(mc.zombieRange) or 2000) then
 local isEvt  = e.isEvent or e.isUnique
 local isRare = isEvt or (e.rarity ~= nil and e.rarity <= rareBelow)
 local show
 if eventsOnly then show = isEvt
 elseif mc.zombiesRareOnly then show = isRare
 else show = true end
 if show then
 local anchor = e.model and (e.model:FindFirstChild("HumanoidRootPart")
 or e.model.PrimaryPart)
 if anchor then
 z = z + 1
 local d = AR2_minimapZDots[z]
 if not d then
 d = Instance.new("Frame")
 d.AnchorPoint = Vector2.new(0.5, 0.5)
 d.BorderSizePixel = 0
 d.ZIndex = 5
 d.Parent = AR2_minimapImg
 AR2_minimapZDots[z] = d
 end
 local sz = isEvt and 9 or (isRare and 7 or 4)
 d.Size = UDim2.fromOffset(sz, sz)
 d.BackgroundColor3 = isEvt
 and Color3.fromRGB(255, 210, 60)
 or (isRare and Color3.fromRGB(255, 60, 70)
 or Color3.fromRGB(150, 150, 155))
 local u2, v2 = AR2_worldToMap(anchor.Position)
 d.Position = UDim2.fromScale(u2, v2)
 d.Visible = true
 end
 end
 end
 end
 end)
 if not ok then z = 0 end
 end
 for j = z + 1, #AR2_minimapZDots do AR2_minimapZDots[j].Visible = false end
end
function AR2_minimapStart()
 if AR2_minimapConn then return end
 local nextAt = 0
 AR2_minimapConn = AR2_RunService.RenderStepped:Connect(function()
 if not AR2_minimapEnabled then return end
 local now = os.clock()
 local hz  = math.clamp(tonumber(AR2_CFG.minimap.hz) or 20, 2, 60)
 if now < nextAt then return end
 nextAt = now + (1 / hz)
 local ok, err = pcall(AR2_updateMinimap)
 if not ok then
 AR2_minimapErrs = (AR2_minimapErrs or 0) + 1
 AR2_minimapLastErr = tostring(err)
 end
 end)
end
