function AR2_rageBotVisCheck(model, part, origin)
 if not part then return false end
 local W = AR2_CFG.weapon
 local ignore = { AR2_LocalPlayer.Character, model }
 local budget = tonumber(AR2_CFG.rageBot.penBudget)
 or tonumber(W.penBudget) or 5
 if W.penUnlimited then budget = math.huge end
 local pts = { part.Position }
 if model then
 local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
 if root and root ~= part then pts[#pts + 1] = root.Position end
 local head = model:FindFirstChild("Head")
 if head and head ~= part then pts[#pts + 1] = head.Position end
 if root then
 local back = (origin - root.Position)
 if back.Magnitude > 1 then
 pts[#pts + 1] = root.Position + back.Unit * 1.5
 end
 end
 end
 local bestTotal, bestWalls, bestReached = math.huge, 0, false

 if (tonumber(AR2_CFG.magicAim.originRadius) or 0) > 0 then
 pcall(function()
 local dir = (part.Position - origin).Unit
 local nudge = math.clamp((tonumber(AR2_CFG.magicAim.originRadius) or 2) * 0.5, 0, 5)
 local shifted, shiftedClear = AR2_findBestOrigin(origin + dir * nudge, dir, part.Position, model)
 if shiftedClear and shifted then
 bestTotal, bestWalls, bestReached = 0, 0, true
 AR2_lastOriginShifted = true
 end
 end)
 end

 if not bestReached then
 AR2_lastOriginShifted = false
 for _, pos in ipairs(pts) do
 local t, w, r = AR2_penStudsTo(origin, pos, ignore)
 if r and t < bestTotal then bestTotal, bestWalls, bestReached = t, w, true end
 end
 end
 if bestTotal == math.huge then bestTotal = 0 end
 AR2_lastPathStuds, AR2_lastPathWalls = bestTotal, bestWalls
 if not bestReached then
 AR2_lastPathWhy = "no path to target"
 return (W.penUnlimited and W.wallbang) and true or false
 end
 if bestTotal <= 0.01 then
 AR2_lastPathWhy = "clear line"
 return true
 end
 if not (W.wallbang or W.wallbangFilter) then
 AR2_lastPathWhy = ("blocked %.1f studs, wallbang off"):format(bestTotal)
 return false
 end
 if bestTotal > budget then
 AR2_lastPathWhy = ("too thick: %.1f studs > budget %.1f"):format(bestTotal, budget)
 AR2_pathRejects = (AR2_pathRejects or 0) + 1
 return false
 end
 AR2_pathAccepts = (AR2_pathAccepts or 0) + 1
 AR2_lastPathWhy = ("pen %.1f / %.1f studs, %d wall(s)"):format(bestTotal, budget, bestWalls)
