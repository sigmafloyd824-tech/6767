 local function AR2_playerNames()
 local names = {"None"}
 for _, p in ipairs(AR2_Players:GetPlayers()) do
 if p ~= AR2_LocalPlayer and p.Name and p.Name ~= "" then
 table.insert(names, p.Name)
 end
 end
 return names
 end
 local function AR2_setDropdownValues(elem, values)
 if not elem then return false end
 local applied = false
 if type(elem.SetValues) == "function" then
 applied = select(1, pcall(function() elem:SetValues(values) end))
 end
 if not applied and type(elem.Refresh) == "function" then
 applied = select(1, pcall(function() elem:Refresh(values) end))
 end
 return applied
 end
 local function AR2_setDropdownValue(elem, value)
 if not elem then return end
 if type(elem.GetValue) == "function" then
 local ok, cur = pcall(function() return elem:GetValue() end)
 if ok and cur == value then return end
 end
 if type(elem.SetValue) == "function" then
 pcall(function() elem:SetValue(value) end)
 elseif type(elem.Set) == "function" then
 pcall(function() elem:Set(value) end)
 end
 end
 local targetDropdown, carTPDropdown
 local function AR2_refreshTPTargets(notify)
 local names = AR2_playerNames()
 AR2_setDropdownValues(targetDropdown, names)
 AR2_setDropdownValues(carTPDropdown, names)
 local cur = AR2_CFG.tp.target
 local stillHere = (cur == nil or cur == "-" or cur == "None")
 if not stillHere then
 for _, n in ipairs(names) do
 if n == cur then stillHere = true break end
 end
 end
 if not stillHere then
 AR2_CFG.tp.target = "-"
 AR2_setDropdownValue(targetDropdown, "None")
 AR2_setDropdownValue(carTPDropdown, "None")
 end
 if notify then
 local n = #names - 1
 pcall(function()
 Notif.new({Title="DROIDWARE",Content="Player list refreshed ("..n.." player"..(n==1 and "" or "s")..")",Duration=3})
 end)
 end
 return names
 end
