function AR2_hpColor(pct)
 pct = math.clamp(pct, 0, 1)
 if pct >= 0.999 then
 return Color3.fromRGB(0, 255, 70)
 end
 if pct > 0.5 then
 local t = (pct - 0.5) * 2
 return Color3.fromRGB(math.floor(255*(1-t)), 210 + math.floor(45*t), 60)
 else
 local t = pct * 2
 return Color3.fromRGB(230, math.floor(200*t), 45)
 end
end
function AR2_drawEntity(model, color, label, sub, opt)
 local x, y, w, h = AR2_screenBox(model, opt.skeleton ~= nil)
 if not x then return false end
 AR2_slot = AR2_slot + 1
 local v = AR2_acquireVisual(AR2_slot)
 local ts = AR2_CFG.style.textSize or 13
 if opt.box then AR2_paintBox(v, x, y, w, h, color)
 else
 v.box.Visible = false v.outline.Visible = false v.fill.Visible = false
 for _, l in ipairs(v.corners) do l.Visible = false end
 end
 local cx = math.floor(x + w/2 + 0.5)
 if label and label ~= "" then
 v.name.Text, v.name.Color, v.name.Size = label, color, ts
 v.name.Position = Vector2.new(cx, math.floor(y - ts - 3))
 v.name.Visible  = true
 else v.name.Visible = false end
 if sub and sub ~= "" then
 v.info.Text, v.info.Color, v.info.Size = sub, (AR2_COLORS.info or Color3.fromRGB(220,220,225)), ts - 1
 v.info.Position = Vector2.new(cx, math.floor(y + h + 3))
 v.info.Visible  = true
 else v.info.Visible = false end
 local cam = Workspace.CurrentCamera
 if opt.tracer and cam then
 local vp = cam.ViewportSize
 local origin = AR2_CFG.style.tracerFromBottom
 and Vector2.new(math.floor(vp.X/2), math.floor(vp.Y))
 or  Vector2.new(math.floor(vp.X/2), math.floor(vp.Y/2))
 v.tracer.From = origin
 v.tracer.To   = Vector2.new(math.floor(x + w/2 + 0.5), math.floor(y + h + 0.5))
 v.tracer.Color, v.tracer.Thickness = color, AR2_CFG.style.tracerThickness or 1
 v.tracer.Visible = true
 else v.tracer.Visible = false end
 if opt.healthBar and v.hbBg and v.hbFill then
 local hp, maxHp
 local player = AR2_Players:GetPlayerFromCharacter(model)
 if player then
 local cap = (AR2_CFG.style and AR2_CFG.style.hpMax) or 100
 hp, maxHp = AR2_clientHP[player.Name], AR2_clientMaxHP[player.Name] or cap
 if hp == nil or (AR2_CFG.style and AR2_CFG.style.hpTrack == false) then
 local rh, rm = AR2_readEntityHealth(model)
 if rh then hp, maxHp = rh, rm end
 end
 else hp, maxHp = AR2_readEntityHealth(model) end
 local tooSmall = h < 18
 if hp and maxHp and maxHp > 0 and not tooSmall then
 local pct   = math.clamp(hp / maxHp, 0, 1)
 local barW  = 4
 local barX  = math.floor(x - barW - 5)
 local by    = math.floor(y)
 local bh    = math.floor(h)
 local fillH = math.max(1, math.floor(bh * pct))
 v.hbBg.Position = Vector2.new(barX - 1, by - 1)
 v.hbBg.Size     = Vector2.new(barW + 2, bh + 2)
 v.hbBg.Color, v.hbBg.Transparency, v.hbBg.Visible = Color3.fromRGB(8,8,10), 0.85, true
 v.hbFill.Position = Vector2.new(barX, by + bh - fillH)
 v.hbFill.Size     = Vector2.new(barW, fillH)
 v.hbFill.Color, v.hbFill.Transparency, v.hbFill.Visible = AR2_hpColor(pct), 1, true
 if AR2_CFG.style.healthText and v.htxt then
 v.htxt.Text = tostring(math.floor(hp))
 v.htxt.Color = AR2_hpColor(pct)
 v.htxt.Position = Vector2.new(barX - 1, math.floor(y + h - fillH - ts))
 v.htxt.Center = false
 v.htxt.Visible = true
 elseif v.htxt then v.htxt.Visible = false end
 else
 v.hbBg.Visible, v.hbFill.Visible = false, false
 if v.htxt then v.htxt.Visible = false end
 end
 else
 if v.hbBg   then v.hbBg.Visible   = false end
 if v.hbFill then v.hbFill.Visible = false end
 if v.htxt   then v.htxt.Visible   = false end
 end
 return true
end
