local function AR2_meleeTargets(originPos, range, maxN)
 local out = {}
 local function consider(list, want)
 if not want then return end
 for _, e in ipairs(list) do
 if not e.isLocal and e.model then
 local part = e.model:FindFirstChild("UpperTorso")
 or e.model:FindFirstChild("Head")
 or e.root
 if part and typeof(part) == "Instance" then
 local d = (part.Position - originPos).Magnitude
 if d <= range then
 out[#out + 1] = { part = part, dist = d }
 end
 end
 end
 end
 end
 pcall(function() consider(AR2_api.players(), AR2_CFG.melee.players) end)
 pcall(function() consider(AR2_api.zombies(), AR2_CFG.melee.zombies) end)
 table.sort(out, function(a, b) return a.dist < b.dist end)
 while #out > (maxN or 4) do table.remove(out) end
 return out
end
