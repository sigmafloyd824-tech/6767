 L[#L+1] = ("  %-26s %s = %s"):format(label, tv, tostring(v))
 return
 end
 local n = 0
 L[#L+1] = ("  %-26s table"):format(label)
 for k, vv in pairs(v) do
 n = n + 1
 if n <= 12 then
 if type(vv) == "table" and (depth or 0) < 1 then
 show("    " .. tostring(k), vv, (depth or 0) + 1)
 else
 L[#L+1] = ("      %-22s %s = %s"):format(
 tostring(k):sub(1,22), type(vv),
 type(vv) == "table" and "{...}" or tostring(vv))
 end
 end
 end
 if n > 12 then L[#L+1] = ("      ... +%d more"):format(n - 12) end
 if n == 0 then L[#L+1] = "      (empty)" end
 end
 for _, fn in ipairs({ "GetSkins", "GetPurchases" }) do
 local ok, res = pcall(function() return P[fn](P) end)
 if not ok then ok, res = pcall(function() return P[fn]() end) end
 L[#L+1] = ("  %s() -> ok=%s"):format(fn, tostring(ok))
 if ok then show(fn .. " result", res) end
 end
 show("NewWeaponSkin", rawget(P, "NewWeaponSkin"))
 show("NewPurchase",   rawget(P, "NewPurchase"))
 local names = {}
 pcall(function()
 local id = fw.Configs and fw.Configs.ItemData
 if type(id) == "table" then
 for k in pairs(id) do
 names[#names+1] = k
 if #names >= 6 then break end
 end
 end
 end)
 L[#L+1] = ""
 L[#L+1] = "  GetSkinConfig on real ItemData names:"
 for _, nm in ipairs(names) do
