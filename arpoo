 or (st.tier == "mod"   and AR2_COLORS.mod)
 or AR2_COLORS.staffLo or color
 end
 local label = c.name and e.name or nil
 if st and sc and sc.esp and sc.tagName then
 label = ("[" .. st.role:upper() .. "] ")
 .. (label or tostring(e.name or "?"))
 end
 local bits = {}
