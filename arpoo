 elseif mode == "Jitter" then
 yawDeg = flip() and MAXY or -MAXY
 elseif mode == "Sweep" then
 local ph = (t / math.pi) % 2
 yawDeg = (ph < 1 and (ph * 2 - 1) or (3 - ph * 2)) * MAXY
 elseif mode == "Fold" then
 yawDeg, pitch = 180, -85
 elseif mode == "Upside Down" then
 yawDeg, pitch = 180, 85
 elseif mode == "Fold Spin" then
 yawDeg, pitch = math.deg(t % (math.pi * 2)), -85
 elseif mode == "Max Left" then
 yawDeg = -MAXY
 elseif mode == "Max Right" then
 yawDeg = MAXY
 elseif mode == "Random" then
 if (os.clock() - (AR2_lookAARandAt or 0)) > 0.08 then
 AR2_lookAARandAt  = os.clock()
 AR2_lookAARandYaw = math.random() * 360
 AR2_lookAARandPit = (math.random() * 2 - 1) * 85
 end
 yawDeg = AR2_lookAARandYaw or 0
 pitch  = AR2_lookAARandPit or 0
 else
 yawDeg = 180
 end
 if cfg.moveBody == false then
 yawDeg = math.clamp(((yawDeg + 180) % 360) - 180, -MAXY, MAXY)
 end
 local base = (typeof(real) == "Vector3" and real.Magnitude > 1e-3) and real
 or Vector3.new(0, 0, -1)
 local flat = Vector3.new(base.X, 0, base.Z)
 if flat.Magnitude < 1e-3 then flat = Vector3.new(0, 0, -1) end
 local dir = CFrame.Angles(0, math.rad(yawDeg), 0) * flat.Unit
 if pitch ~= 0 then
 dir = dir + Vector3.new(0, math.tan(math.rad(math.clamp(pitch, -88, 88))), 0)
 end
 return (dir.Magnitude > 1e-3) and dir.Unit or Vector3.new(0, 0, -1)
end
