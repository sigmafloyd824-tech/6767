 end
 AR2_minimapDots[i] = dot
 end
 if wantAvatars then
 local px = math.clamp(tonumber(AR2_CFG.minimap.avatarSize) or 18, 10, 40)
 dot.Size = UDim2.fromOffset(px, px)
 local want = ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(pl.UserId)
