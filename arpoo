AR2_itemTypeCache = nil
function AR2_itemTypeOf(itemName)
 if not itemName or itemName == "" then return nil end
 if not AR2_itemTypeCache then
 AR2_itemTypeCache = {}
 local data = AR2_findItemData and AR2_findItemData() or nil
 if type(data) == "table" then
 pcall(function()
 for k, v in pairs(data) do
 if type(v) == "table" then
 local nm = rawget(v, "ItemName")
 if (nm == nil or nm == "") and type(k) == "string" then nm = k end
 if type(nm) == "string" and nm ~= "" then
 AR2_itemTypeCache[nm] = {
 t = rawget(v, "Type") or "?",
 s = rawget(v, "EquipSlot") or "?",
 }
 end
 end
 end
 end)
 end
 end
 return AR2_itemTypeCache[itemName]
end
