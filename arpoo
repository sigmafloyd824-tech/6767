 local nextAt = 0
 AR2_mapWatchConn = AR2_RunService.Heartbeat:Connect(function()
 local now = os.clock()
 if now < nextAt then return end
 nextAt = now + 2
 pcall(function()
 if AR2_CFG.minimap and AR2_CFG.minimap.on then
 if not AR2_minimapGui or not AR2_minimapGui.Parent then
 pcall(AR2_buildMinimap)
 end
 if not AR2_minimapHiddenBySpec then
 AR2_minimapEnabled = true
 if AR2_minimapGui and not AR2_minimapGui.Enabled then
 AR2_minimapGui.Enabled = true
 end
 end
 if not AR2_minimapConn then pcall(AR2_minimapStart) end
 end
 end)
 pcall(function()
 if AR2_CFG.radar and AR2_CFG.radar.on
 and type(AR2_radar) == "table" and not AR2_radar.running then
 pcall(AR2_radar.start)
 end
 end)
 end)
end
