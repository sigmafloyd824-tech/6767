function AR2_ownStatus()
 local L = { "== OWNERSHIP ==",
 "hooked : " .. tostring(AR2_ownHooked),
 "gates  : " .. tostring(#AR2_ownOriginal) }
 pcall(function()
 local fw = require(AR2_ReplicatedFirst:WaitForChild("Framework", 10))
 local P = fw.Libraries and fw.Libraries.Purchases
 if type(P) ~= "table" then L[#L+1] = "Purchases: unreachable" return end
 local names = {}
 for k, v in pairs(P) do names[#names+1] = tostring(k) .. " (" .. typeof(v) .. ")" end
 table.sort(names)
 L[#L+1] = "Purchases API: " .. table.concat(names, ", ")
 local okS, skins = pcall(function() return P:GetSkins() end)
 local c = 0
 if okS and type(skins) == "table" then for _ in pairs(skins) do c = c + 1 end end
 L[#L+1] = "GetSkins -> " .. c .. " entries"
 if c == 0 then
 local okL = pcall(function() P:Load() end)
 task.wait(0.4)
 local ok2, s2 = pcall(function() return P:GetSkins() end)
 local c2 = 0
 if ok2 and type(s2) == "table" then for _ in pairs(s2) do c2 = c2 + 1 end end
 L[#L+1] = ("after Load(): ok=%s -> %d entries"):format(tostring(okL), c2)
 local okLd, loaded = pcall(function() return P:Loaded() end)
 L[#L+1] = "Loaded() -> " .. (okLd and tostring(loaded) or "threw")
 end
 end)
 return table.concat(L, "\n")
end
