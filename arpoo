function AR2_desyncRewriteState(args, n)
 local rp = AR2_desyncRoot
 if not (rp and rp.Parent and AR2_desyncHome) then return args, n end
 local realPos = rp.Position
 local homePos = AR2_desyncHome.Position
 for i = 1, n do
 local v = args[i]
 if typeof(v) == "Vector3" then
 if (v - realPos).Magnitude < 0.25 then
 args[i] = homePos
 elseif v.Magnitude > 1.5 then
 args[i] = Vector3.zero
 end
 elseif typeof(v) == "CFrame" and (v.Position - realPos).Magnitude < 0.25 then
 args[i] = AR2_desyncHome
 end
 end
 return args, n
end
