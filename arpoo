 if not ok then ok, res = pcall(function() return P.GetSkinConfig(nm) end) end
 L[#L+1] = ("    %-40s ok=%s  %s"):format(nm:sub(1,40), tostring(ok), type(res))
 if ok and type(res) == "table" then show("      cfg", res, 1) end
 end
 L[#L+1] = ""
 L[#L+1] = "  ItemData sample entry shape:"
 pcall(function()
