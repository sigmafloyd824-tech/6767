function AR2_getSmoothedVelocity(model, position)
 local now = os.clock()
 local tracker = AR2_velocityTracker[model]
 if not tracker then
 AR2_velocityTracker[model] = {
 position = position, time = now, velocity = Vector3.zero
 }
 return Vector3.zero
 end
 local dt = now - tracker.time
 if dt < 1 / 40 then
 return tracker.velocity
 end
 local raw = (position - tracker.position) / dt
 local alpha    = 1 - math.exp(-dt / 0.08)
 local smoothed = tracker.velocity + (raw - tracker.velocity) * alpha
