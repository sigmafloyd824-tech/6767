 pcall(function()
 local gc = AR2_resolveGameCharacter()
 inst = gc and rawget(gc, "Instance")
 end)
 dress(inst)
 pcall(function()
 local ch = AR2_LocalPlayer and AR2_LocalPlayer.Character
 if ch and ch ~= inst then dress(ch) end
 end)
 pcall(function()
 local pg = AR2_LocalPlayer and AR2_LocalPlayer:FindFirstChild("PlayerGui")
 if not pg then return end
 for _, d in ipairs(pg:GetDescendants()) do
 if d:IsA("Model") and d.Name == "Mannequin" then dress(d) end
 end
 end)
 AR2_fitLastDressed = dressed
 return dressed > 0, dressed
end
