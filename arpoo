function AR2_serverPathBlocked(origin, dest)
 local RC = AR2_raycastLib()
 local blocker = nil
 local ok = pcall(function()
 if type(RC) ~= "table" or type(rawget(RC, "BulletCastLight")) ~= "function" then
 error("no raycasting library")
 end
 local ignore = {}
 local myChar = AR2_LocalPlayer.Character
 if myChar then ignore[#ignore + 1] = myChar end
 if AR2_hbeFolder then ignore[#ignore + 1] = AR2_hbeFolder end
 local from = origin
 for _ = 1, 16 do
 local seg = dest - from
 if seg.Magnitude <= 0.15 then return end
 local part, pos = RC:BulletCastLight(Ray.new(from, seg), ignore)
 if not part then return end
 local isWater = false
 pcall(function() isWater = part:HasTag("Water Part") end)
 if isWater then
 ignore[#ignore + 1] = part
 from = (pos or from) + seg.Unit * 0.05
 continue
 end
 local isWindow = false
 pcall(function()
 if type(AR2_ENTLIB) == "table" then
 local ent = AR2_ENTLIB:Search(part)
 isWindow = ent and ent.Type == "Window" or false
 end
 end)
 if isWindow then
 ignore[#ignore + 1] = part
 from = (pos or from) + seg.Unit * 0.05
 continue
 end
 local isBody = false
 pcall(function()
 isBody = (RC:IsHitCharacter(part) or RC:IsHitZombie(part)) and true or false
 end)
 if isBody or AR2_isDamageTarget(part) then return end
 blocker = part
 return
 end
 end)
 if ok then return blocker end
 pcall(function()
 local ignore = {}
 local myChar = AR2_LocalPlayer.Character
 if myChar then ignore[#ignore + 1] = myChar end
 if AR2_hbeFolder then ignore[#ignore + 1] = AR2_hbeFolder end
 local rp = RaycastParams.new()
 rp.FilterType = Enum.RaycastFilterType.Exclude
 rp.FilterDescendantsInstances = ignore
 local from = origin
 for _ = 1, 16 do
 local seg = dest - from
 if seg.Magnitude <= 0.15 then return end
 local hit = AR2_Workspace:Raycast(from, seg, rp)
 if not hit then return end
 if AR2_isDamageTarget(hit.Instance) then return end
 if not AR2_serverFilterSkips(hit.Instance) then
 blocker = hit.Instance
 return
 end
 ignore[#ignore + 1] = hit.Instance
 rp.FilterDescendantsInstances = ignore
 from = hit.Position + seg.Unit * 0.05
 end
 end)
 return blocker
end
function AR2_findLegalOrigin(origin, dest)
 local blocked = AR2_serverPathBlocked(origin, dest)
 if not blocked then return origin, 0, nil end
 local c       = AR2_CFG.rageBot
 local steps   = math.clamp(math.floor(tonumber(c.originWalkSteps) or 6), 2, 12)
 local minOff  = math.clamp(tonumber(c.originWalkMin) or 2, 0.5, 50)
 local back    = origin - dest
 local total   = back.Magnitude
 if total <= minOff then return origin, 0, blocked end
 back = back.Unit
 local lo, hi, best = minOff, total, nil
 for _ = 1, steps do
 local mid  = (lo + hi) * 0.5
 local cand = dest + back * mid
 if AR2_serverPathBlocked(cand, dest) then
 hi = mid
 else
 best = cand
 lo = mid
 end
 end
 if best then return best, (origin - best).Magnitude, nil end
 local cand = dest + back * minOff
 return cand, (origin - cand).Magnitude, AR2_serverPathBlocked(cand, dest)
end
