 for i = 1, math.min(#AR2_spyLog, 60) do
 local e = AR2_spyLog[i]
 out[#out + 1] = string.format('%2d  +%.2fs  "%s"', i, e.t, e.msg)
 for j = 1, #e.args do
 out[#out + 1] = "        arg" .. j .. "  " .. e.args[j]
 end
 end
 out[#out + 1] = ""
