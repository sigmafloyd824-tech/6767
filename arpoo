local function advCorpseEntry(m)
 local e = advCorpseCache[m]
 if e and e.primary and e.primary.Parent then return e end
 local primary = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
 if not primary then return nil end
 e = {
