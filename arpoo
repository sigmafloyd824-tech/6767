function AR2_httpFn()
 return (syn and syn.request) or (http and http.request) or http_request or request
end

function AR2_b64(data)
 local ok, r
 if crypt then
 if type(crypt.base64encode) == "function" then
 ok, r = pcall(crypt.base64encode, data) if ok and r then return r end
 end
 if type(crypt.base64) == "table" and type(crypt.base64.encode) == "function" then
 ok, r = pcall(crypt.base64.encode, data) if ok and r then return r end
 end
 end
 local b, out, i, n = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", {}, 1, #data
 while i <= n do
 local c1, c2, c3 = data:byte(i), data:byte(i+1), data:byte(i+2)
 local n1 = math.floor(c1 / 4)
 local n2 = (c1 % 4) * 16 + math.floor((c2 or 0) / 16)
 local n3 = ((c2 or 0) % 16) * 4 + math.floor((c3 or 0) / 64)
 local n4 = (c3 or 0) % 64
 out[#out+1] = b:sub(n1+1,n1+1) .. b:sub(n2+1,n2+1)
 .. (c2 and b:sub(n3+1,n3+1) or "=")
 .. (c3 and b:sub(n4+1,n4+1) or "=")
 i = i + 3
 end
 return table.concat(out)
end

function AR2_spotRefresh()
 local S = AR2_spotify
 if S.clientId == "" or S.clientSecret == "" or S.refreshToken == "" then
 S.status = "missing credentials" return false
 end
 local req = AR2_httpFn()
 if not req then S.status = "executor has no http request fn" return false end
 local ok, res = pcall(req, {
 Url    = "https://accounts.spotify.com/api/token",
 Method = "POST",
 Headers = {
 ["Authorization"] = "Basic " .. AR2_b64(S.clientId .. ":" .. S.clientSecret),
 ["Content-Type"]  = "application/x-www-form-urlencoded",
 },
 Body = "grant_type=refresh_token&refresh_token=" .. S.refreshToken,
 })
 if not ok or not res then S.status = "request failed" return false end
 if (res.StatusCode or 0) >= 300 then
 S.status = "auth failed (" .. tostring(res.StatusCode) .. ")" return false
 end
 local okj, d = pcall(function() return AR2_HttpService:JSONDecode(res.Body) end)
 if not okj or type(d) ~= "table" or not d.access_token then
 S.status = "bad token response" return false
 end
 S.token   = d.access_token
 S.expires = os.clock() + (tonumber(d.expires_in) or 3600) - 60
 S.status  = "connected"
 return true
end

function AR2_spotToken()
 local S = AR2_spotify
 if S.token ~= "" and os.clock() < S.expires then return S.token end
 if AR2_spotRefresh() then return S.token end
 return nil
end

function AR2_spotCall(method, path, body)
 local t = AR2_spotToken()
 if not t then return nil end
 local req = AR2_httpFn()
 if not req then return nil end
 local ok, res = pcall(req, {
 Url    = "https://api.spotify.com/v1" .. path,
 Method = method,
 Headers = {
 ["Authorization"] = "Bearer " .. t,
 ["Content-Type"]  = "application/json",
 },
 Body = body,
 })
 if not ok then return nil end
 return res
end

function AR2_spotPoll()
 local S = AR2_spotify
 local res = AR2_spotCall("GET", "/me/player/currently-playing")
 if not res then S.now = nil return end
 if res.StatusCode == 204 then S.now = nil S.status = "nothing playing" return end
 if (res.StatusCode or 0) >= 300 then
 S.status = "api error " .. tostring(res.StatusCode) return
 end
 local ok, d = pcall(function() return AR2_HttpService:JSONDecode(res.Body) end)
 if not ok or type(d) ~= "table" or type(d.item) ~= "table" then S.now = nil return end
 local artists = {}
 pcall(function()
 for _, a in ipairs(d.item.artists or {}) do artists[#artists+1] = tostring(a.name) end
 end)
 S.now = {
 track   = tostring(d.item.name or "?"),
 artist  = table.concat(artists, ", "),
 ms      = tonumber(d.progress_ms) or 0,
 dur     = tonumber(d.item.duration_ms) or 0,
 playing = d.is_playing and true or false,
 }
 S.status = "connected"
end

