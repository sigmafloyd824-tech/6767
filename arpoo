AR2_bodyDesyncT      = 0
AR2_bodyDesyncSavedAR = nil

function AR2_bodyDesyncRoot()
 local char = AR2_LocalPlayer.Character
 if not char then return nil, nil end
 local root = char:FindFirstChild("HumanoidRootPart")
 local hum  = char:FindFirstChildWhichIsA("Humanoid")
 return root, hum
end

function AR2_bodyDesyncCamYaw()
 local cam = AR2_Workspace.CurrentCamera
 if not cam then return 0 end
 local lv = cam.CFrame.LookVector
 local flat = Vector3.new(lv.X, 0, lv.Z)
 if flat.Magnitude < 1e-4 then return 0 end
 flat = flat.Unit

 return math.deg(math.atan2(-flat.X, -flat.Z))
end
function AR2_bodyDesyncAngle(dt)
 local d = AR2_CFG.misc.bodyDesync
 local mode = tostring(d.mode or "Jitter")
 AR2_bodyDesyncT = AR2_bodyDesyncT + dt * (tonumber(d.speed) or 8)

 if mode == "Backwards" then
 return 180
 elseif mode == "Jitter" then
 AR2_bodyDesyncFlip = not AR2_bodyDesyncFlip
 local a = tonumber(d.range) or 90
 return AR2_bodyDesyncFlip and a or -a
 elseif mode == "Backwards Jitter" then
 AR2_bodyDesyncFlip = not AR2_bodyDesyncFlip
 local a = tonumber(d.range) or 90
 return 180 + (AR2_bodyDesyncFlip and a or -a) * 0.25
 elseif mode == "Spin" then
 AR2_bodyDesyncYaw = (AR2_bodyDesyncYaw + dt * (tonumber(d.speed) or 8) * 60) % 360
 return AR2_bodyDesyncYaw
 elseif mode == "Sway" then
 return math.sin(AR2_bodyDesyncT) * (tonumber(d.range) or 90)
 elseif mode == "Sideways" then
 return 90
 elseif mode == "Random" then
 return math.random(-180, 180)
 end
 return 0
end

function AR2_bodyDesyncAim(yawDeg)
 local d = AR2_CFG.misc.bodyDesync
 if not (d and d.splitAim) then return end
 local gc = AR2_resolveGameCharacter()
 if type(gc) ~= "table" then return end
 local anim = rawget(gc, "Animator")
 if not anim then return end

 local cam = AR2_Workspace.CurrentCamera
 local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
 local a = math.rad(yawDeg + 180)
 local fake = Vector3.new(math.sin(a), look.Y, math.cos(a))

 local sp = rawget(gc, "LookDirectionSpring")
 if sp and type(sp.SetGoal) == "function" and typeof(fake) == "Vector3" then
 pcall(function() sp:SetGoal(fake) end)
 end
end

AR2_bodyDesyncUpperBind = "AR2_BodyDesyncUpper"
AR2_bodyDesyncUT        = 0
AR2_bodyDesyncLastOff   = 0

function AR2_bodyDesyncJoints()
 local char = AR2_LocalPlayer and AR2_LocalPlayer.Character
 if not char then return nil, nil end
 local ut   = char:FindFirstChild("UpperTorso")
 local lt   = char:FindFirstChild("LowerTorso")
 local waist = ut and ut:FindFirstChild("Waist")
 local rootj = lt and lt:FindFirstChild("Root")
 if not waist then
 local torso = char:FindFirstChild("Torso")
 waist = torso and torso:FindFirstChild("Neck")
 rootj = (char:FindFirstChild("HumanoidRootPart")
 and char.HumanoidRootPart:FindFirstChild("RootJoint")) or rootj
 end
 return waist, rootj
end
function AR2_bodyDesyncUpperStep(dt)
 local d = AR2_CFG.misc.bodyDesync
 if not (d and d.enabled and d.upper) then return end
 local waist, rootj = AR2_bodyDesyncJoints()
 if not (waist or rootj) then return end

 AR2_bodyDesyncUT = AR2_bodyDesyncUT + dt * (tonumber(d.upperSpeed) or 10)
 local amp  = math.rad(tonumber(d.upperRange) or 70)
 local mode = tostring(d.upperMode or "Twist")
 local yaw, pitch, roll = 0, 0, 0

 if mode == "Twist" then
 yaw = math.sin(AR2_bodyDesyncUT) * amp
 elseif mode == "Snap" then
 yaw = (math.floor(AR2_bodyDesyncUT * 2) % 2 == 0) and amp or -amp
 elseif mode == "Spin" then
 yaw = (AR2_bodyDesyncUT % (math.pi * 2))
 elseif mode == "Break" then
 yaw   = math.sin(AR2_bodyDesyncUT) * amp
 pitch = math.sin(AR2_bodyDesyncUT * 1.7) * amp * 0.6
 roll  = math.cos(AR2_bodyDesyncUT * 1.3) * amp * 0.5
 elseif mode == "Backwards" then
 yaw = math.pi
 end

 if waist then
 pcall(function()
 waist.Transform = waist.Transform * CFrame.Angles(pitch, yaw, roll)
 end)
 end

 if d.counterRoot and rootj then
 pcall(function()
 rootj.Transform = rootj.Transform
 * CFrame.Angles(0, -math.rad(AR2_bodyDesyncLastOff or 0), 0)
 end)
 end
end
function AR2_bodyDesyncStep(dt)
 local d = AR2_CFG.misc.bodyDesync
 if not (d and d.enabled) then return end
 local root, hum = AR2_bodyDesyncRoot()
 if not root then return end

 if hum and hum.AutoRotate then
 if AR2_bodyDesyncSavedAR == nil then AR2_bodyDesyncSavedAR = true end
 hum.AutoRotate = false
 end

 local offset = AR2_bodyDesyncAngle(dt)
 local pitch  = tonumber(d.lean) or 0
 local pos    = root.Position

 local base = 0
 if d.followCam ~= false then base = AR2_bodyDesyncCamYaw() end
 local yaw = base + offset
 AR2_bodyDesyncLastOff = offset

 local cf = CFrame.new(pos)
 * CFrame.Angles(0, math.rad(yaw), 0)
 * CFrame.Angles(math.rad(pitch), 0, 0)

 local vel = root.AssemblyLinearVelocity
 root.CFrame = cf
 root.AssemblyLinearVelocity  = vel
 root.AssemblyAngularVelocity = Vector3.zero

 pcall(function()
 local gc = AR2_resolveGameCharacter()
 local st = type(gc) == "table" and rawget(gc, "States") or nil
 if type(st) == "table" and (st.Shoving or st.Staggered) then return end
 AR2_bodyDesyncAim(yaw)
 end)
end

function AR2_setBodyDesync(on)
 AR2_CFG.misc.bodyDesync.enabled = on and true or false

 pcall(function() AR2_RunService:UnbindFromRenderStep(AR2_bodyDesyncBind) end)
 pcall(function() AR2_RunService:UnbindFromRenderStep(AR2_bodyDesyncUpperBind) end)
 if AR2_bodyDesyncConn then
 pcall(function() AR2_bodyDesyncConn:Disconnect() end)
 AR2_bodyDesyncConn = nil
 end

 if not AR2_CFG.misc.bodyDesync.enabled then
 local _, hum = AR2_bodyDesyncRoot()
 if hum and AR2_bodyDesyncSavedAR ~= nil then hum.AutoRotate = AR2_bodyDesyncSavedAR end
 AR2_bodyDesyncSavedAR = nil
 return
 end

 AR2_bodyDesyncT, AR2_bodyDesyncYaw = 0, 0

 AR2_bodyDesyncConn = AR2_RunService.Heartbeat:Connect(function(dt)
 pcall(AR2_bodyDesyncStep, dt)
 end)

 pcall(function()
 AR2_RunService:BindToRenderStep(AR2_bodyDesyncUpperBind,
 Enum.RenderPriority.Character.Value + 1,
 function(dt) pcall(AR2_bodyDesyncUpperStep, dt) end)
 end)
end

