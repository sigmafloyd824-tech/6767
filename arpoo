function AR2_skin()
 local ui = (AR2_CFG and AR2_CFG.ui) or {}
 local s = {
 accent  = ui.accent     or Color3.fromRGB(230, 30, 40),
 bg      = ui.background or Color3.fromRGB(12, 12, 12),
 panel   = ui.panel      or Color3.fromRGB(22, 16, 18),
 text    = Color3.fromRGB(228, 224, 228),
 muted   = Color3.fromRGB(150, 148, 156),
 radius  = 11,
 trans   = 0.03,
 }
 local L = AR2_UILIB
 if L then
 pcall(function() if L.accentColor  then s.accent = L.accentColor  end end)
 pcall(function() if L.sidebarColor then s.bg     = L.sidebarColor end end)
 pcall(function() if L.surfaceColor then s.panel  = L.surfaceColor end end)
 pcall(function() if L.textColor    then s.text   = L.textColor    end end)
 pcall(function() if L.textMuted    then s.muted  = L.textMuted    end end)
 pcall(function() if L.groupColor   then s.panel  = L.groupColor   end end)
 end

 pcall(function()
 local _, bg = AR2_liveWindow()
 if not bg then return end

 local grad = bg:FindFirstChildWhichIsA("UIGradient")
 if grad then
 local okG = pcall(function()
 local kp = grad.Color.Keypoints
 local mid = kp[math.max(1, math.ceil(#kp / 2))].Value

 local lum = mid.R * 0.299 + mid.G * 0.587 + mid.B * 0.114
 if lum < 0.5 then s.bg = mid end
 end)
 if not okG then s.bg = s.bg end
 else
 local c3  = bg.BackgroundColor3
 local lum = c3.R * 0.299 + c3.G * 0.587 + c3.B * 0.114
 if lum < 0.6 then s.bg = c3 end
 end
 s.trans = bg.BackgroundTransparency
 local c = bg:FindFirstChildWhichIsA("UICorner")
 if c then s.radius = c.CornerRadius.Offset end
 end)
 return s
end

