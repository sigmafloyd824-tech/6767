do
 local BG     = Color3.fromRGB(13, 12, 13)
 local LINE   = Color3.fromRGB(58, 34, 39)
 local ACCENT = Color3.fromRGB(226, 29, 44)
 local TEXT   = Color3.fromRGB(238, 235, 236)
 local DIM    = Color3.fromRGB(146, 136, 139)
 local WARN   = Color3.fromRGB(255, 176, 64)
 local PAD, ROW_H, TITLE_H = 6, 13, 16
 local T_SIZE, R_SIZE = 13, 12
 AR2_ZDRAW = { panels = {}, built = 0 }
 local function font()
 local f = 2
 pcall(function() f = (Drawing.Fonts and Drawing.Fonts.Plex) or 2 end)
 return f
 end
 local function widthOf(t, str, size)
 local w
 pcall(function() w = t.TextBounds and t.TextBounds.X end)
 if type(w) == "number" and w > 0 then return w end
 return #tostring(str) * size * 0.52
 end
 local function mkText(size, colour)
 local t = Drawing.new("Text")
 t.Size = size
 t.Center = false
 t.Outline = true
 t.Visible = false
 t.Color = colour
 pcall(function() t.OutlineColor = Color3.fromRGB(0, 0, 0) end)
 pcall(function() t.Font = font() end)
 return t
 end
 local function mkPanel()
 local bg = Drawing.new("Square")
 bg.Filled, bg.Thickness, bg.Visible = true, 1, false
 bg.Color, bg.Transparency = BG, 0.82
 local br = Drawing.new("Square")
 br.Filled, br.Thickness, br.Visible = false, 1, false
 br.Color, br.Transparency = LINE, 1
 local ac = Drawing.new("Square")
 ac.Filled, ac.Thickness, ac.Visible = true, 1, false
 ac.Color, ac.Transparency = ACCENT, 1
 return { bg = bg, br = br, ac = ac,
 title = mkText(T_SIZE, TEXT), meta = mkText(R_SIZE, DIM),
 rows = {} }
 end
 local function row(pn, i)
 local r = pn.rows[i]
 if r then return r end
 r = { name = mkText(R_SIZE, TEXT), val = mkText(R_SIZE, DIM) }
 pn.rows[i] = r
 return r
 end
 local function panel(i)
 local pn = AR2_ZDRAW.panels[i]
 if pn then return pn end
 pn = mkPanel()
 AR2_ZDRAW.panels[i] = pn
 AR2_ZDRAW.built = i
 return pn
 end
 local function hidePanel(pn)
 pn.bg.Visible, pn.br.Visible, pn.ac.Visible = false, false, false
 pn.title.Visible, pn.meta.Visible = false, false
 for _, r in ipairs(pn.rows) do r.name.Visible, r.val.Visible = false, false end
 end
 local function hideFrom(n)
 for i = n, AR2_ZDRAW.built do
 local pn = AR2_ZDRAW.panels[i]
 if pn then hidePanel(pn) end
 end
 end
 function AR2_zPanelsHide() hideFrom(1) end
 function AR2_zPanelsDestroy()
 for _, pn in ipairs(AR2_ZDRAW.panels) do
 pcall(function()
 pn.bg:Remove() pn.br:Remove() pn.ac:Remove()
 pn.title:Remove() pn.meta:Remove()
 for _, r in ipairs(pn.rows) do r.name:Remove() r.val:Remove() end
 end)
 end
 AR2_ZDRAW.panels, AR2_ZDRAW.built = {}, 0
 end
 local function buildRows(e, c)
 local rows = {}
 if e.agroState == "Attacking" or e.agroState == "Investigating" then
 rows[#rows+1] = { k = e.agroState, v = "", col = WARN }
 end
 if c.canStun and e.canStun then
 rows[#rows+1] = { k = "STUNS", v = "", col = WARN }
 end
 if c.threat and e.threat then
 rows[#rows+1] = { k = "Threat", v = tostring(e.threat), col = DIM }
 end
 local cfg  = e.cfg or AR2_zombieConfig(e.name)
 local list = cfg and AR2_zombieDropList(cfg)
 if list then
 local rareAt = tonumber(c.rareDropBelow) or 0.15
 local maxRows = math.clamp(tonumber(c.panelRows) or 4, 1, 10)
 for i = 1, math.min(#list, maxRows) do
 local d = list[i]
 local isRare = d.chance ~= nil and d.chance <= rareAt
 rows[#rows+1] = {
 k = d.name,
 v = d.chance and ("%.0f%%"):format(d.chance * 100) or "-",
 col = isRare and ACCENT or TEXT,
 vcol = isRare and ACCENT or DIM,
 }
 end
 end
 return rows
 end
 function AR2_zPanelsUpdate()
 local c = AR2_CFG.zombies
 if not (c.on and c.dropsPanel) or not AR2_hasDrawing then
 if AR2_ZDRAW.built > 0 then hideFrom(1) end
 return
 end
 local cam = AR2_Workspace.CurrentCamera
 if not cam then hideFrom(1) return end
 local range  = tonumber(c.dropsDist) or 2000
 local maxPan = math.clamp(tonumber(c.panelMax) or 6, 1, 14)
 local pick = {}
 local ok = pcall(function()
 for _, e in ipairs(AR2_api.zombies()) do
 if e.distance and e.distance <= range and e.model then
 pick[#pick + 1] = e
 end
 end
 end)
 if not ok then hideFrom(1) return end
 table.sort(pick, function(a, b) return a.distance < b.distance end)
 local used = 0
 for _, e in ipairs(pick) do
 if used >= maxPan then break end
 local anchor = e.head or e.root
 if anchor then
 local sp, on = cam:WorldToViewportPoint(anchor.Position)
 if on and sp.Z > 0 then
 local rows = buildRows(e, c)
 if #rows > 0 then
 used = used + 1
 local pn = panel(used)
 local isEvt = e.isEvent or e.isUnique
 local rare  = isEvt
 or (e.rarity ~= nil and e.rarity <= (tonumber(c.rareBelow) or 0.3))
 local title = tostring(e.label or e.name or "?")
 local meta  = e.isEvent and "EVENT"
 or (e.isUnique and "UNIQUE")
 or (("%dm"):format(math.floor(e.distance)))
 pn.title.Text = title
 pn.title.Color = rare and ACCENT or TEXT
 pn.meta.Text  = meta
 pn.meta.Color = rare and ACCENT or DIM
 local w = widthOf(pn.title, title, T_SIZE)
 + widthOf(pn.meta, meta, R_SIZE) + 14
 for i, rw in ipairs(rows) do
 local r = row(pn, i)
 r.name.Text = rw.k
 r.val.Text  = rw.v
 local lw = widthOf(r.name, rw.k, R_SIZE)
 + widthOf(r.val, rw.v, R_SIZE) + 16
 if lw > w then w = lw end
 end
 w = math.clamp(w + PAD * 2, 96, 260)
 local h = TITLE_H + #rows * ROW_H + PAD * 2
 local x = sp.X + 24
 if x + w > cam.ViewportSize.X - 4 then x = sp.X - w - 24 end
 x = math.max(4, x)
 local y = math.clamp(sp.Y - h / 2, 4, cam.ViewportSize.Y - h - 4)
 x, y = math.floor(x), math.floor(y)
 pn.bg.Size = Vector2.new(w, h)
 pn.bg.Position = Vector2.new(x, y)
 pn.bg.Visible = true
 pn.br.Size = Vector2.new(w, h)
 pn.br.Position = Vector2.new(x, y)
 pn.br.Visible = true
 pn.ac.Size = Vector2.new(2, h)
 pn.ac.Position = Vector2.new(x, y)
 pn.ac.Visible = true
 pn.title.Position = Vector2.new(x + PAD + 3, y + PAD - 2)
 pn.title.Visible = true
 pn.meta.Position = Vector2.new(
 x + w - PAD - widthOf(pn.meta, meta, R_SIZE), y + PAD - 1)
 pn.meta.Visible = true
 for i, rw in ipairs(rows) do
 local r = row(pn, i)
 local ry = y + PAD + TITLE_H + (i - 1) * ROW_H - 2
 r.name.Color = rw.col
 r.name.Position = Vector2.new(x + PAD + 3, ry)
 r.name.Visible = true
 if rw.v ~= "" then
 r.val.Color = rw.vcol or DIM
 r.val.Position = Vector2.new(
 x + w - PAD - widthOf(r.val, rw.v, R_SIZE), ry)
 r.val.Visible = true
 else
 r.val.Visible = false
 end
 end
 for i = #rows + 1, #pn.rows do
 pn.rows[i].name.Visible = false
 pn.rows[i].val.Visible  = false
 end
 end
 end
 end
 end
 hideFrom(used + 1)
 end
end
function AR2_updateMinimap()
 if not AR2_minimapEnabled then
 if AR2_minimapGui then AR2_minimapGui.Enabled = false end
 return
 end
 if not AR2_minimapGui or not AR2_minimapGui.Parent then AR2_buildMinimap() end
 AR2_minimapGui.Enabled = true
