function AR2_reportClamp(args, n)
 local ch   = AR2_LocalPlayer and AR2_LocalPlayer.Character
 local root = ch and ch:FindFirstChild("HumanoidRootPart")
 if not root then return args, n end
 local realPos = root.Position
 local now     = os.clock()
 local maxSpd  = math.clamp(tonumber(AR2_CFG.misc.flySmoothSpeed) or 28, 4, 200)
 if not AR2_reportPos then
 AR2_reportPos, AR2_reportAt = realPos, now
 return args, n
 end
 local dt = math.clamp(now - AR2_reportAt, 0, 0.5)
 AR2_reportAt = now
 local toReal = realPos - AR2_reportPos
 local step   = maxSpd * dt
 if toReal.Magnitude <= step then
 AR2_reportPos = realPos
 else
 AR2_reportPos = AR2_reportPos + toReal.Unit * step
 end
 AR2_reportDrift = (realPos - AR2_reportPos).Magnitude
 for i = 1, n do
 local v = args[i]
 if typeof(v) == "Vector3" then
 if (v - realPos).Magnitude < 0.25 then
 args[i] = AR2_reportPos
 elseif v.Magnitude > maxSpd * 1.2 then
 args[i] = v.Unit * maxSpd
 end
 elseif typeof(v) == "CFrame" and (v.Position - realPos).Magnitude < 0.25 then
 args[i] = v - v.Position + AR2_reportPos
 end
 end
 return args, n
end
