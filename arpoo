local function updateAdvCorpse()
 if not advCorpseESP.enabled or not AR2_Corpses then return end
 local now = os.clock()
 if now < advCorpseNext then return end
 advCorpseNext = now + (1 / 15)
 local camPos = AR2_Camera.CFrame.Position
 local shown  = {}
 for _, m in ipairs(AR2_Corpses:GetChildren()) do
 if m:IsA("Model") then
 local e = advCorpseEntry(m)
 if e and not e.infected then
 local dist = (camPos - e.primary.Position).Magnitude
 if dist <= advCorpseESP.maxDistance then
 shown[#shown + 1] = { m = m, e = e, d = dist }
 else
 if e.hl then e.hl.Enabled = false end
 if e.bb then e.bb.Enabled = false end
 end
 end
 end
 end
 table.sort(shown, function(a, b) return a.d < b.d end)
 for i, rec in ipairs(shown) do
 local e, on = rec.e, i <= AR2_ADV_CORPSE_HL_CAP
 if e.hl then e.hl.Enabled = on end
 if e.bb then
 e.bb.Enabled = on
 if e.nl then e.nl.Visible = advCorpseESP.showNames and on end
 if e.dl then
 e.dl.Visible = advCorpseESP.showDistance and on
 if on then e.dl.Text = "[" .. math.floor(rec.d) .. "m]" end
 end
 end
 end
end
